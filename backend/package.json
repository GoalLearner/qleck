{
  "name": "qleck-api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply qleck --local",
    "migrate:remote": "wrangler d1 migrations apply qleck --remote",
    "harness": "node harness/run.mjs && node harness/outcomes.check.mjs",
    "dev:watch": "node dev-supervisor.mjs",
    "calibrate": "node harness/calibration.mjs",
    "check:apple": "node harness/apple.check.mjs",
    "check:auth": "node harness/auth.check.mjs",
    "check:goals": "node harness/goals.check.mjs",
    "check:witness": "node harness/witness.check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "typescript": "~5.9.0",
    "wrangler": "^4.127.0"
  }
}
